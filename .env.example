# Copy to .env and replace with a newly generated key from the Sarvam dashboard.
SARVAM_API_KEY=""
SARVAM_DUBBING_BASE_URL="https://api.sarvam.ai/dubbing"

# Product configuration
DATABASE_URL="file:./dev.db"
INITIAL_GUEST_CREDITS="100"
DEMO_UPLOAD_LIMIT_MB="50"
SARVAM_DISABLE_WATERMARK="false"

# Optional: override if ffmpeg / ffprobe are not already available on PATH.
FFMPEG_PATH="ffmpeg"
FFPROBE_PATH="ffprobe"

# Public production origin used for canonical links, robots.txt, and sitemap.xml.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
